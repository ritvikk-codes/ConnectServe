# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your MongoDB Atlas URI or local connection string:
# If left empty, an embedded in-memory MongoDB will be used automatically for zero-friction local development.
MONGODB_URI=mongodb://localhost:27017/connectserve

# JWT Authentication Secrets
JWT_SECRET=connectserve_production_super_secret_jwt_key_2026_x89!
JWT_EXPIRES_IN=7d
REFRESH_SECRET=connectserve_production_refresh_token_secret_key_2026_#99
REFRESH_EXPIRES_IN=30d

# Cloudinary Storage Configuration (MANDATORY for media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Notification Service (Nodemailer SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@connectserve.org

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
